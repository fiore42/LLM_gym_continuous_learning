YOUTUBE_API_KEY=
X_API_BEARER_TOKEN=
# Optional OAuth user-context token for protected accounts your X user follows.
X_API_USER_ACCESS_TOKEN=
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
WHISPER_SCRIPT=whispermlx-subtitles.sh
FFPROBE_PATH=ffprobe
# Optional provider-neutral synthesis configuration.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=
AGENT_PROVIDER=openai-compatible
AGENT_INPUT_COST_PER_MILLION=0
AGENT_OUTPUT_COST_PER_MILLION=0

# Optional assisted-verification drafter. Keep this provider and budget
# separate from the agent under review.
# JUDGE_PROVIDER=anthropic
# JUDGE_API_KEY=
# JUDGE_BASE_URL=https://api.anthropic.com
# JUDGE_MODEL=claude-haiku-4-5
# JUDGE_INPUT_COST_PER_MILLION=1.00
# JUDGE_OUTPUT_COST_PER_MILLION=5.00

# Optional A/B benchmark environments. Keep credentials out of command lines.
# Each arm is configured in full, with no fallback to AGENT_*: a comparison
# report must record what each arm actually was, and an arm that silently
# inherits another's settings is how a comparison starts lying.
# FRONTIER_PROVIDER=anthropic
# FRONTIER_API_KEY=
# FRONTIER_BASE_URL=https://api.anthropic.com
# FRONTIER_MODEL=
# FRONTIER_INPUT_COST_PER_MILLION=0
# FRONTIER_OUTPUT_COST_PER_MILLION=0
# OPEN_WEIGHT_PROVIDER=openai-compatible
# OPEN_WEIGHT_API_KEY=
# OPEN_WEIGHT_BASE_URL=
# OPEN_WEIGHT_MODEL=
# OPEN_WEIGHT_INPUT_COST_PER_MILLION=0
# OPEN_WEIGHT_OUTPUT_COST_PER_MILLION=0

# Provider request-body shape. An OpenAI-compatible URL does not imply an
# OpenAI-compatible body, so these are set per provider prefix rather than
# assumed. Unset defaults preserve the OpenAI shape: response_format
# json_object, no thinking field. The Anthropic client defaults thinking to
# disabled.
#   {PREFIX}_RESPONSE_FORMAT = json_object | text | none   (none omits it)
#   {PREFIX}_THINKING        = enabled | disabled | none   (none omits it)
#
# GLM-5.2 via Z.ai — response_format is undocumented, and reasoning is on by
# default at max effort, which bills as output and can consume the whole
# token budget before any JSON is emitted:
# OPEN_WEIGHT_PROVIDER=openai-compatible
# OPEN_WEIGHT_BASE_URL=https://api.z.ai/api/paas/v4
# OPEN_WEIGHT_MODEL=glm-5.2
# OPEN_WEIGHT_RESPONSE_FORMAT=none
# OPEN_WEIGHT_THINKING=disabled
# OPEN_WEIGHT_INPUT_COST_PER_MILLION=1.40
# OPEN_WEIGHT_OUTPUT_COST_PER_MILLION=4.40

# For Anthropic Messages API instead:
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
